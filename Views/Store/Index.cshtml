@model List<Shop.Models.Product>
@{
    Layout = "_LayoutStore";
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Banner Section -->
<section style="background: var(--color-primary-soft); padding: var(--space-6) var(--space-5); border-radius: var(--radius-card); text-align: center; margin-bottom: var(--space-6); border: 1px solid rgba(37, 99, 235, 0.1);">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: var(--space-2); color: var(--color-primary); line-height: 1.2;">
        Chào mừng đến với ShopStore
    </h1>
    <p style="font-size: 1.0625rem; color: var(--color-muted); max-width: 600px; margin: 0 auto;">
        Khám phá những thiết bị công nghệ chính hãng mới nhất với giá tốt nhất thị trường.
    </p>
</section>

<!-- Product List Heading -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
    <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text);">Sản phẩm nổi bật</h2>
    <span class="badge badge--muted">@Model.Count sản phẩm có sẵn</span>
</div>

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", (
        "empty",
        "Cửa hàng đang cập nhật sản phẩm",
        "Hiện tại kho hàng đang được nhập mới. Quý khách vui lòng quay lại sau ít phút."
    ))
}
else
{
    <div class="store-grid">
        @foreach (var item in Model)
        {
            <article class="card store-card" style="overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                <!-- Product Image Container -->
                <div style="height: 220px; background: #F8FAFC; display: flex; align-items: center; justify-content: center; position: relative; border-bottom: 1px solid var(--color-border);">
                    @if (!string.IsNullOrEmpty(item.ImageFileName))
                    {
                        <img src="~/images/products/@item.ImageFileName" alt="@item.Name" loading="lazy" style="max-width: 100%; max-height: 100%; object-fit: contain; padding: var(--space-4);" />
                    }
                    else
                    {
                        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--color-surface); display: flex; align-items: center; justify-content: center; color: var(--color-muted);" aria-hidden="true">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                <line x1="12" y1="18" x2="12.01" y2="18"></line>
                            </svg>
                        </div>
                    }

                    <div style="position: absolute; top: 12px; right: 12px;">
                        <span class="badge badge--success">Còn @item.StockQuantity</span>
                    </div>
                </div>

                <!-- Product Content -->
                <div style="padding: var(--space-4); flex: 1; display: flex; flex-direction: column;">
                    <h3 style="font-size: 1.0625rem; margin-bottom: var(--space-2); font-weight: 600; color: var(--color-text); line-height: 1.3;">
                        @item.Name
                    </h3>

                    <p style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: var(--space-4); font-variant-numeric: tabular-nums;">
                        @item.Price.ToString("N0") ₫
                    </p>

                    <div style="margin-top: auto;">
                        <a href="@Url.Action("Detail", "Store", new { id = item.Id })" class="btn btn--primary" style="width: 100%; justify-content: center;">
                            <span>Xem chi tiết</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>
}
