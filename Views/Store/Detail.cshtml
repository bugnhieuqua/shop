@model Shop.Models.Product
@{
    Layout = "_LayoutStore";
    ViewData["Title"] = Model.Name;
    string catName = ViewBag.CategoryName as string ?? "Thiết bị";
}

<!-- Back navigation link -->
<div style="margin-bottom: var(--space-4);">
    <a href="@Url.Action("Index", "Store")" style="display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-muted); text-decoration: none; font-size: 0.9375rem; font-weight: 500;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Quay lại danh sách sản phẩm</span>
    </a>
</div>

<!-- Product Detail Container -->
<div class="card store-detail-card" style="padding: var(--space-6);">
    <!-- Left column: Big Product Image -->
    <div class="store-detail-image" style="background: #F8FAFC; border-radius: var(--radius-card); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; min-height: 380px; padding: var(--space-5);">
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <img src="~/images/products/@Model.ImageFileName" alt="@Model.Name" style="max-width: 100%; max-height: 360px; object-fit: contain;" />
        }
        else
        {
            <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--color-surface); display: flex; align-items: center; justify-content: center; color: var(--color-muted);" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
            </div>
        }
    </div>

    <!-- Right column: Information & Purchase -->
    <div class="store-detail-info" style="display: flex; flex-direction: column; justify-content: center;">
        <div style="margin-bottom: var(--space-2);">
            <span class="badge badge--muted">@catName</span>
        </div>

        <h1 style="font-size: 2rem; font-weight: 800; color: var(--color-text); margin-bottom: var(--space-3); line-height: 1.25;">
            @Model.Name
        </h1>

        <div style="font-size: 1.875rem; font-weight: 700; color: var(--color-primary); margin-bottom: var(--space-4); font-variant-numeric: tabular-nums;">
            @Model.Price.ToString("N0") ₫
        </div>

        <div style="margin-bottom: var(--space-5); display: flex; align-items: center; gap: var(--space-2); font-size: 0.9375rem; color: var(--color-muted);">
            <span>Tình trạng kho:</span>
            @if (Model.StockQuantity > 10)
            {
                @await Html.PartialAsync("_StatusBadge", ("success", $"Còn hàng ({Model.StockQuantity} cái)"))
            }
            else if (Model.StockQuantity > 0)
            {
                @await Html.PartialAsync("_StatusBadge", ("warning", $"Sắp hết ({Model.StockQuantity} cái)"))
            }
            else
            {
                @await Html.PartialAsync("_StatusBadge", ("danger", "Hết hàng"))
            }
        </div>

        <div style="padding: var(--space-4); background: var(--color-bg); border-radius: var(--radius-input); margin-bottom: var(--space-5); border: 1px solid var(--color-border); font-size: 0.875rem; color: var(--color-muted); line-height: 1.6;">
            Sản phẩm chính hãng mới 100%, nguyên hộp, đầy đủ phụ kiện. Bảo hành 12 tháng tại các trung tâm uỷ quyền toàn quốc.
        </div>

        <div>
            @if (Model.StockQuantity > 0)
            {
                <button type="button" class="btn btn--primary" style="padding: var(--space-3) var(--space-5); font-size: 1rem; width: 100%; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span>Thêm vào giỏ hàng</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn--outline" disabled style="padding: var(--space-3) var(--space-5); font-size: 1rem; width: 100%; justify-content: center; opacity: 0.6; cursor: not-allowed;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    <span>Tạm hết hàng</span>
                </button>
            }
        </div>
    </div>
</div>
