@model Shop.ViewModels.EmployeeCreateVm
@{
    ViewData["Title"] = "Sửa nhân viên";
    var employeeId = ViewBag.EmployeeId as int?;
}

@await Html.PartialAsync("_PageHeader", (
    $"Sửa nhân viên #{employeeId}",
    "Cập nhật hồ sơ và quyền truy cập",
    (string?)null,
    (string?)null
))

<form asp-action="Edit" asp-route-id="@employeeId" method="post" class="form-card" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-alert form-alert--danger"></div>

    <fieldset class="form-section">
        <legend>Thông tin cá nhân</legend>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FullName" class="form-label">
                    Họ tên <span class="req" aria-hidden="true">*</span>
                </label>
                <input asp-for="FullName" class="input" autocomplete="name" />
                <span asp-validation-for="FullName" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="form-label">Điện thoại</label>
                <input asp-for="Phone" class="input" type="tel" autocomplete="tel" />
                <span asp-validation-for="Phone" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">
                Email <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="Email" class="input" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>
    </fieldset>

    <fieldset class="form-section">
        <legend>Tài khoản & trạng thái</legend>

        <div class="form-group">
            <label asp-for="UserId" class="form-label">
                Tài khoản đăng nhập <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="UserId" class="input" autocomplete="username" />
            <span asp-validation-for="UserId" class="form-error"></span>
            <p class="form-hint">Thay đổi tài khoản có thể ảnh hưởng đến lịch sử đăng nhập.</p>
        </div>

        <label class="form-check">
            <input asp-for="IsActive" type="checkbox" />
            <span>Nhân viên đang làm việc (có thể đăng nhập & lập hoá đơn)</span>
        </label>
    </fieldset>

    <div class="form-actions form-actions--sticky">
        <a href="@Url.Action("Employee", "Home")" class="btn btn--ghost">Huỷ</a>
        <button type="submit" class="btn btn--primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Lưu thay đổi</span>
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
